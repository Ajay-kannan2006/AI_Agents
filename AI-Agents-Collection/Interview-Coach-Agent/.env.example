# Interview Coach Agent - Environment Configurations
APP_NAME="Interview Coach Agent"
APP_ENV="development"
DEBUG=true
PORT=8001
HOST="0.0.0.0"

# LLM Configuration (OpenAI or OpenAI Compatible e.g. Ollama/vLLM)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_BASE="https://api.openai.com/v1"

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./data/storage.db"

# Logging
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"
